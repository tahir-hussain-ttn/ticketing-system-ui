{
    "openapi": "3.1.0",
    "info": {
      "title": "Ticket Management Backend API",
      "description": "Support Ticket Management System backend",
      "version": "1.0"
    },
    "servers": [
      {
        "url": "http://localhost:8080",
        "description": "Generated server url"
      }
    ],
    "tags": [
      {
        "name": "Ticket Comments",
        "description": "Adding and listing comments on a ticket (FR-005; 002-list-comments)"
      },
      {
        "name": "Authentication",
        "description": "Login and logout (spec 005)"
      },
      {
        "name": "Chatbot",
        "description": "RAG resolution chatbot (spec 005)"
      },
      {
        "name": "Tickets",
        "description": "Ticket lifecycle: create, view, update, and status transitions"
      }
    ],
    "paths": {
      "/api/v1/tickets": {
        "get": {
          "tags": [
            "Tickets"
          ],
          "summary": "List tickets",
          "description": "Lists tickets, optionally filtered by keyword/status and scoped by ownership (FR-016, FR-017). Requires authentication.",
          "operationId": "list",
          "parameters": [
            {
              "name": "q",
              "in": "query",
              "description": "Keyword matched against title and description",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "status",
              "in": "query",
              "description": "Filter by exact ticket status",
              "required": false,
              "schema": {
                "type": "string",
                "enum": [
                  "OPEN",
                  "IN_PROGRESS",
                  "RESOLVED",
                  "CLOSED",
                  "CANCELLED"
                ]
              }
            },
            {
              "name": "scope",
              "in": "query",
              "description": "MINE, ASSIGNED, or ALL (default: all)",
              "required": false,
              "schema": {
                "type": "string",
                "enum": [
                  "MINE",
                  "ASSIGNED",
                  "ALL"
                ]
              }
            },
            {
              "name": "page",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "size",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 20
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Page of tickets matching the given filters",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketPage"
                  }
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Tickets"
          ],
          "summary": "Create a ticket",
          "description": "Creates a ticket with status OPEN, auto-assigned to the least-loaded SUPPORT user (FR-001, FR-009, FR-010, FR-012). Requires authentication (FR-006).",
          "operationId": "create",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketCreateRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "description": "Ticket created",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Validation failed",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "401": {
              "description": "Not authenticated",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/tickets/{ticketId}/transitions": {
        "post": {
          "tags": [
            "Tickets"
          ],
          "summary": "Transition ticket status",
          "description": "Applies a status transition per the allowed state machine (FR-009, FR-010).",
          "operationId": "transition",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketTransitionRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket not found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "409": {
              "description": "Transition not allowed from the current status, or a concurrent update conflict",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/tickets/{ticketId}/comments": {
        "get": {
          "tags": [
            "Ticket Comments"
          ],
          "summary": "List a ticket's comments",
          "description": "Retrieves a ticket's comments as their own paginated, oldest-to-newest list, independent of the ticket's other fields (002-list-comments FR-001, FR-002, FR-005).",
          "operationId": "listComments",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            },
            {
              "name": "page",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "size",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 20
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Page of comments; content is [] when the ticket has no comments (FR-003)",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/CommentPage"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket not found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Ticket Comments"
          ],
          "summary": "Add a comment",
          "description": "Adds a timestamped comment to an existing ticket (FR-005).",
          "operationId": "addComment",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommentCreateRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "description": "Comment created",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/CommentResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Validation failed (e.g. empty content)",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket not found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/chatbot/messages": {
        "post": {
          "tags": [
            "Chatbot"
          ],
          "summary": "Send a chatbot query",
          "description": "FR-021-FR-025, FR-028, FR-033/FR-034.",
          "operationId": "sendMessage",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatbotQueryRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ChatbotTurnResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Blank/empty query",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "401": {
              "description": "Not authenticated",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "conversationId supplied but not found/not owned/already ended",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "503": {
              "description": "Embedding or response-generation service unavailable",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/chatbot/conversations/{conversationId}/end": {
        "post": {
          "tags": [
            "Chatbot"
          ],
          "summary": "Explicitly end a conversation",
          "description": "FR-036.",
          "operationId": "endConversation",
          "parameters": [
            {
              "name": "conversationId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Conversation ended"
            },
            "401": {
              "description": "Not authenticated",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "Not found, not owned by the caller, or already ended",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/auth/logout": {
        "post": {
          "tags": [
            "Authentication"
          ],
          "summary": "Log out, ending the current session",
          "description": "FR-008.",
          "operationId": "logout",
          "responses": {
            "204": {
              "description": "Session ended"
            },
            "401": {
              "description": "No authenticated session to end",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/auth/login": {
        "post": {
          "tags": [
            "Authentication"
          ],
          "summary": "Log in with email and password",
          "description": "FR-001, FR-003, FR-004.",
          "operationId": "login",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/LoginResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Missing email or password",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "401": {
              "description": "Incorrect password or unregistered email",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/tickets/{ticketId}": {
        "get": {
          "tags": [
            "Tickets"
          ],
          "summary": "Get ticket details",
          "description": "Full ticket record including comments (FR-003). Requires authentication and view authorization: creator, assignee, or SUPPORT/ADMIN only (FR-037).",
          "operationId": "getById",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketDetailResponse"
                  }
                }
              }
            },
            "401": {
              "description": "Not authenticated",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "403": {
              "description": "Not the creator, assignee, or SUPPORT/ADMIN",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        },
        "patch": {
          "tags": [
            "Tickets"
          ],
          "summary": "Update ticket fields",
          "description": "Updates title/description/priority (FR-004). Never accepts status — status changes only via POST .../transitions (FR-013 of spec 001). Never accepts assignee — reassignment only via PATCH .../assignee (FR-013 of spec 005).",
          "operationId": "update",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketUpdateRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Validation failed",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket not found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "409": {
              "description": "Concurrent update conflict",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      },
      "/api/v1/tickets/{ticketId}/assignee": {
        "patch": {
          "tags": [
            "Tickets"
          ],
          "summary": "Manually reassign a ticket",
          "description": "ADMIN only (spec 005 FR-013).",
          "operationId": "reassign",
          "parameters": [
            {
              "name": "ticketId",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReassignRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Target user is not a SUPPORT user",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "403": {
              "description": "Caller is not ADMIN",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            },
            "404": {
              "description": "Ticket or target user not found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ApiError"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "TicketCreateRequest": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 200,
              "minLength": 0
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "priority": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          },
          "required": [
            "description",
            "title"
          ]
        },
        "TicketResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "RESOLVED",
                "CLOSED",
                "CANCELLED"
              ]
            },
            "assignee": {
              "$ref": "#/components/schemas/UserSummary"
            },
            "createdBy": {
              "$ref": "#/components/schemas/UserSummary"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "UserSummary": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "ApiError": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "path": {
              "type": "string"
            },
            "fieldErrors": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ApiFieldError"
              }
            }
          }
        },
        "ApiFieldError": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "TicketTransitionRequest": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "IN_PROGRESS",
                "RESOLVED",
                "CLOSED",
                "CANCELLED"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "CommentCreateRequest": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "content"
          ]
        },
        "CommentResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "ticketId": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string"
            },
            "authorName": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "ChatbotQueryRequest": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1
            },
            "conversationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "query"
          ]
        },
        "ChatbotTurnResponse": {
          "type": "object",
          "properties": {
            "conversationId": {
              "type": "string",
              "format": "uuid"
            },
            "responseText": {
              "type": "string"
            },
            "sourceTicketIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "confidentMatch": {
              "type": "boolean"
            }
          }
        },
        "LoginRequest": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "minLength": 1
            },
            "password": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "email",
            "password"
          ]
        },
        "LoginResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "SUPPORT",
                "GENERAL",
                "ADMIN"
              ]
            }
          }
        },
        "TicketUpdateRequest": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 200,
              "minLength": 0
            },
            "description": {
              "type": "string"
            },
            "priority": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH",
                "CRITICAL"
              ]
            }
          }
        },
        "ReassignRequest": {
          "type": "object",
          "properties": {
            "assigneeId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "assigneeId"
          ]
        },
        "TicketPage": {
          "type": "object",
          "properties": {
            "content": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TicketResponse"
              }
            },
            "page": {
              "type": "integer",
              "format": "int32"
            },
            "size": {
              "type": "integer",
              "format": "int32"
            },
            "totalElements": {
              "type": "integer",
              "format": "int64"
            },
            "totalPages": {
              "type": "integer",
              "format": "int32"
            }
          }
        },
        "TicketDetailResponse": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "priority": {
